{
  "name": "@pirx/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p ../mcp-server/tsconfig.json && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "start": "node --enable-source-maps dist/index.js",
    "import:logs": "node --enable-source-maps dist/import-logs-cli.js",
    "gpu:sampler": "node --enable-source-maps dist/gpu-sampler-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "ollama": "0.6.3"
  }
}
