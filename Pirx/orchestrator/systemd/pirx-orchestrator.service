[Unit]
Description=Pirx supervised orchestration worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai-assistant/Pirx
EnvironmentFile=%h/.config/pirx/orchestrator.env
ExecStart=/usr/bin/env node --enable-source-maps orchestrator/dist/headless-cli.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillMode=control-group

[Install]
WantedBy=default.target
