# Skopiuj ten plik do bench/cloud/runpod.env i ustaw chmod 600.
# Plik runpod.env jest ignorowany przez Git.

# Utwórz klucz w https://console.runpod.io/user/settings z uprawnieniami
# do odczytu i zarządzania Podami. Nie commituj go.
RUNPOD_API_KEY=""

# Id istniejącego Network Volume z modelami Ollamy.
# Możesz je wyświetlić poleceniem:
#   ./bench/cloud/runpod-pipeline.sh volumes
RUNPOD_NETWORK_VOLUME_ID=""

# Prywatny klucz odpowiadający kluczowi publicznemu dodanemu do RunPod.
RUNPOD_SSH_KEY="/home/pepus/.ssh/id_ed25519"

# Ustawienia Poda. Network Volume wymusza Secure Cloud i jego datacenter.
RUNPOD_GPU_TYPE_ID="NVIDIA RTX PRO 6000 Blackwell Server Edition"
RUNPOD_GPU_COUNT=1
RUNPOD_IMAGE="runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04"
RUNPOD_CONTAINER_DISK_GB=50
RUNPOD_POD_NAME="pirx-final-benchmark"
RUNPOD_REMOTE_ROOT="/workspace/ai-assistant"
RUNPOD_MODELS_DIR="/workspace/ollama/models"

# Domyślnie brakujące modele zatrzymują pipeline. Zmień na true tylko jeśli
# świadomie chcesz pobrać duże pliki na Network Volume.
RUNPOD_PULL_MISSING_MODELS=false

# Finaliści. Lista jest rozdzielana spacjami.
CLOUD_BENCH_MODELS="gemma4:31b-it-q4_K_M qwen3.6:35b-a3b-q4_K_M qwen3.5:122b-a10b-q4_K_M qwen3:32b-q4_K_M qwen3:14b-q4_K_M"

# Kontrolowane ustawienia benchmarku.
CLOUD_BENCH_THINK=true
CLOUD_BENCH_REPEATS=1
CLOUD_BENCH_SEED=42
CLOUD_BENCH_MAX_TIME=600
CLOUD_OLLAMA_TEMPERATURE=0
CLOUD_OLLAMA_NUM_CTX=8192
CLOUD_OLLAMA_NUM_PREDICT=4096

# Limity oczekiwania w sekundach.
RUNPOD_READY_TIMEOUT_SECONDS=1200
RUNPOD_JOB_TIMEOUT_SECONDS=14400
RUNPOD_POLL_SECONDS=20
